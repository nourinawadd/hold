@page "/"
@page "/lists"

<PageTitle>Lists — Hold</PageTitle>

<div class="page-head">
    <h1>Lists</h1>
    <span class="meta">@lists.Count lists · @lists.Sum(l => l.ItemCount) items</span>
</div>

<div class="list-grid">
    @foreach (var list in lists)
    {
        <article class="list-card">
            <div class="thumbs">
                @for (var slot = 0; slot < 5; slot++)
                {
                    <div class="thumb @(slot < list.ItemCount ? "thumb--filled" : null)"></div>
                }
            </div>

            <div class="list-card__foot">
                <div>
                    <h2>@list.Name</h2>
                    <p class="meta">@list.ItemCount products · @Ago(list.UpdatedAt)</p>
                </div>
                <span class="meta">@list.Total</span>
            </div>
        </article>
    }
</div>

@code {
    private record FakeList(string Name, int ItemCount, DateTimeOffset UpdatedAt, string Total);

    private readonly List<FakeList> lists =
    [
        new("Wishlist", 3, DateTimeOffset.Now.AddHours(-6), "$1,204"),
        new("Gifts", 4, DateTimeOffset.Now.AddDays(-2), "$310"),
        new("Travel", 0, DateTimeOffset.Now.AddDays(-11), "—"),
    ];

    private static string Ago(DateTimeOffset when)
    {
        var elapsed = DateTimeOffset.Now - when;

        return elapsed switch
        {
            { TotalMinutes: < 2 } => "just now",
            { TotalHours: < 1 } => $"{(int)elapsed.TotalMinutes} minutes ago",
            { TotalHours: < 24 } => $"{(int)elapsed.TotalHours} hours ago",
            { TotalDays: < 30 } => $"{(int)elapsed.TotalDays} days ago",
            _ => when.ToString("d MMM yyyy"),
        };
    }
}