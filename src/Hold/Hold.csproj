<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.6.0" />

    <!-- Not in the CLAUDE.md package list. Added for the scraper's last-resort strategy:
         when a shop publishes no structured data, the page text is read by a model. Inert
         and unregistered unless an API key is configured. -->
    <PackageReference Include="Anthropic" Version="12.39.0" />

    <!-- CLAUDE.md specifies SQLite. Postgres instead, agreed deliberately: a SQLite database is
         a file beside the app, and no free host offers a filesystem that survives a redeploy. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
