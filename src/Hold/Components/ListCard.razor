@* One list in the grid. Owns its delete confirmation; the parent owns the data. *@

<article class="list-card">
    @* Buttons must not sit inside this anchor — nesting them is invalid HTML and breaks
       keyboard activation. The actions live as siblings below. *@
    <a class="list-card__open" href="/lists/@List.Id">
        @* Images first, then a plain block for each remaining item, then dashed outlines for
           the empty slots. Filling from the left means a list whose only pictured items were
           saved last still leads with them. *@
        <div class="thumbs">
            @for (var slot = 0; slot < ListService.ThumbnailSlots; slot++)
            {
                if (slot < List.Images.Count)
                {
                    <div class="thumb thumb--image">
                        <img src="@ProductImage.AtWidth(List.Images[slot], ImageWidth)"
                             alt="" loading="lazy" />
                    </div>
                }
                else if (slot < List.ItemCount)
                {
                    <div class="thumb thumb--filled"></div>
                }
                else
                {
                    <div class="thumb"></div>
                }
            }
        </div>

        <div class="list-card__foot">
            <div class="list-card__naming">
                <h2>@List.Name</h2>
                <p class="meta">@List.ItemCount products · @Ago(List.UpdatedAt)</p>
            </div>

            @* One line per currency. Amounts are never combined across currencies, and
               stacking them keeps a two-currency list from squeezing the name beside it. *@
            <div class="list-card__totals">
                @if (List.Totals.Count == 0)
                {
                    <span class="meta">—</span>
                }
                else
                {
                    @foreach (var total in List.Totals)
                    {
                        <span class="meta">@($"{total.Amount:N2} {total.Currency}")</span>
                    }
                }
            </div>
        </div>
    </a>

    @* No actions unless the parent wired them. On the all-items view these cards are
       navigation, and a Delete that silently did nothing would be worse than no Delete. *@
    @if (!Editable)
    {
        // Nothing — the card is a link and only a link.
    }
    else if (confirming)
    {
        <div class="list-card__confirm">
            <p class="confirm-question">@Question()</p>

            <div class="list-card__actions">
                <button type="button" @ref="confirmButton" @onclick="Confirm">Delete</button>
                <button type="button" class="quiet" @onclick="() => confirming = false">Cancel</button>
            </div>
        </div>
    }
    else
    {
        <div class="list-card__actions">
            <button type="button" class="quiet" @onclick="() => OnRename.InvokeAsync(List.Id)">Rename</button>
            <button type="button" class="quiet" @onclick="Ask">Delete</button>
        </div>
    }
</article>

@code {
    [Parameter, EditorRequired]
    public ListSummary List { get; set; } = null!;

    /// <summary>
    /// Passed down rather than read from an injected TimeProvider, so every card in a
    /// render agrees on what "6 hours ago" means.
    /// </summary>
    [Parameter, EditorRequired]
    public DateTimeOffset Now { get; set; }

    /// <summary>
    /// How wide a thumbnail to ask the shop's CDN for. A parameter rather than a constant
    /// because the same card is drawn at two sizes: full width on Lists, and in a narrow grid
    /// on All items, which would be downloading pictures four times larger than it draws.
    /// </summary>
    [Parameter]
    public int ImageWidth { get; set; } = ProductImage.ThumbnailWidth;

    [Parameter]
    public EventCallback<int> OnRename { get; set; }

    [Parameter]
    public EventCallback<int> OnDelete { get; set; }

    private bool confirming;
    private bool pendingFocus;
    private ElementReference confirmButton;

    /// <summary>
    /// True only when the parent actually handles the actions. HasDelegate is the honest
    /// test — an unwired EventCallback silently swallows the click.
    /// </summary>
    private bool Editable => OnRename.HasDelegate || OnDelete.HasDelegate;

    private void Ask()
    {
        confirming = true;
        pendingFocus = true;
    }

    private Task Confirm() => OnDelete.InvokeAsync(List.Id);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!pendingFocus)
        {
            return;
        }

        // Cleared before awaiting: FocusAsync triggers another render, and leaving the flag
        // set would fight the user for the caret on every one of them.
        pendingFocus = false;
        await confirmButton.FocusAsync();
    }

    // Naming what goes with the list is the whole point of the confirmation — deleting a
    // list cascades to its items.
    private string Question() => List.ItemCount switch
    {
        0 => $"Delete {List.Name}?",
        1 => $"Delete {List.Name} and its 1 item?",
        _ => $"Delete {List.Name} and its {List.ItemCount} items?",
    };

    private string Ago(DateTimeOffset when)
    {
        var elapsed = Now - when;

        return elapsed switch
        {
            { TotalMinutes: < 2 } => "just now",
            { TotalHours: < 1 } => $"{(int)elapsed.TotalMinutes} minutes ago",
            { TotalHours: < 24 } => $"{(int)elapsed.TotalHours} hours ago",
            { TotalDays: < 30 } => $"{(int)elapsed.TotalDays} days ago",
            // Stored as UTC, so format in local time or the date slips near midnight.
            _ => when.ToLocalTime().ToString("d MMM yyyy"),
        };
    }

}
