<article class="list-card">
    <a class="list-card__open" href="/lists/@List.Id">
        <div class="thumbs">
            @for (var slot = 0; slot < ListService.ThumbnailSlots; slot++)
            {
                if (slot < List.Images.Count)
                {
                    <div class="thumb thumb--image">
                        <img src="@ProductImage.AtWidth(List.Images[slot], ImageWidth)"
                             alt="" loading="lazy" />
                    </div>
                }
                else if (slot < List.ItemCount)
                {
                    <div class="thumb thumb--filled"></div>
                }
                else
                {
                    <div class="thumb"></div>
                }
            }
        </div>

        <div class="list-card__foot">
            <div class="list-card__naming">
                <h2>@List.Name</h2>
                <p class="meta">@List.ItemCount products · @Ago(List.UpdatedAt)</p>
            </div>

            <div class="list-card__totals">
                @if (List.Totals.Count == 0)
                {
                    <span class="meta">—</span>
                }
                else
                {
                    @foreach (var total in List.Totals)
                    {
                        <span class="meta">@total.Display()</span>
                    }
                }
            </div>
        </div>
    </a>

    @if (Editable && confirming)
    {
        <div class="list-card__confirm">
            <p class="confirm-question">@Question()</p>

            <div class="list-card__actions">
                <button type="button" @ref="confirmButton" @onclick="Confirm">Delete</button>
                <button type="button" class="quiet" @onclick="() => confirming = false">Cancel</button>
            </div>
        </div>
    }
    else if (Editable)
    {
        <div class="list-card__actions">
            <button type="button" class="quiet" @onclick="() => OnRename.InvokeAsync(List.Id)">Rename</button>
            <button type="button" class="quiet" @onclick="Ask">Delete</button>
        </div>
    }
</article>

@code {
    [Parameter, EditorRequired]
    public ListSummary List { get; set; } = null!;

    [Parameter, EditorRequired]
    public DateTimeOffset Now { get; set; }

    [Parameter]
    public int ImageWidth { get; set; } = ProductImage.ThumbnailWidth;

    [Parameter]
    public EventCallback<int> OnRename { get; set; }

    [Parameter]
    public EventCallback<int> OnDelete { get; set; }

    private bool confirming;
    private bool pendingFocus;
    private ElementReference confirmButton;

    private bool Editable => OnRename.HasDelegate || OnDelete.HasDelegate;

    private void Ask()
    {
        confirming = true;
        pendingFocus = true;
    }

    private Task Confirm() => OnDelete.InvokeAsync(List.Id);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!pendingFocus)
        {
            return;
        }

        pendingFocus = false;
        await confirmButton.FocusAsync();
    }

    private string Question() => List.ItemCount switch
    {
        0 => $"Delete {List.Name}?",
        1 => $"Delete {List.Name} and its 1 item?",
        _ => $"Delete {List.Name} and its {List.ItemCount} items?",
    };

    private string Ago(DateTimeOffset when)
    {
        var elapsed = Now - when;

        return elapsed switch
        {
            { TotalMinutes: < 2 } => "just now",
            { TotalHours: < 1 } => $"{(int)elapsed.TotalMinutes} minutes ago",
            { TotalHours: < 24 } => $"{(int)elapsed.TotalHours} hours ago",
            { TotalDays: < 30 } => $"{(int)elapsed.TotalDays} days ago",
            _ => when.ToLocalTime().ToString("d MMM yyyy"),
        };
    }

}
