@inject SettingsService SettingsService
@inject TimeProvider Time

<div class="add-panel">
    <p class="panel-head">@Header</p>

    @if (Message is not null)
    {
        <p class="panel-note">@Message</p>
    }

    <form @onsubmit="Submit" @onsubmit:preventDefault>
        <div class="add-panel__body">
            <div class="preview">
                @if (PreviewSource() is { } source)
                {
                    <img src="@ProductImage.AtWidth(source, ProductImage.CardWidth)" alt="" />
                }
                else
                {
                    <div class="preview__empty"></div>
                }
            </div>

            <div class="fields">
                <div class="field field--wide">
                    <label class="label" for="item-url">Product link (optional)</label>
                    <input id="item-url" @ref="firstInput" @bind="Url" @bind:event="oninput" autocomplete="off" />
                </div>

                <div class="field field--wide">
                    <label class="label" for="item-title">Name</label>
                    <input id="item-title" @ref="titleInput" class="@Faint(ProductField.Title)" @bind="Title" @bind:event="oninput" autocomplete="off" />
                </div>

                <div class="field">
                    <label class="label" for="item-brand">Brand</label>
                    <input id="item-brand" class="@Faint(ProductField.Brand)" @bind="Brand" @bind:event="oninput" autocomplete="off" />
                </div>

                <div class="field">
                    <label class="label" for="item-category">Category</label>
                    <select id="item-category" @bind="category">
                        @foreach (var option in Enum.GetValues<Category>())
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </div>

                <div class="field">
                    <label class="label" for="item-price">@(priceIsEstimate ? "Estimated price" : "Price")</label>
                    <input id="item-price" class="@Faint(ProductField.Price)" type="number" step="0.01" min="0"
                           @bind="Price" @bind:event="oninput" autocomplete="off" />
                </div>

                <div class="field">
                    <label class="label" for="item-currency">Currency</label>
                    <CurrencySelect Id="item-currency" Class="@Faint(ProductField.Currency)"
                                    Value="Currency" ValueChanged="c => Currency = c" />
                </div>

                <div class="field field--wide">
                    <label class="label" for="item-image">Image link</label>
                    <input id="item-image" class="@Faint(ProductField.ImageUrl)" @bind="ImageUrl" @bind:event="oninput" autocomplete="off" />
                </div>

                <div class="field field--wide">
                    <label class="estimate" for="item-estimate">
                        <input id="item-estimate" type="checkbox" @bind="PriceIsEstimate" />
                        <span>This price is my estimate</span>
                    </label>
                </div>

                <div class="field field--wide">
                    <label class="label" for="item-note">Note</label>
                    <input id="item-note" @bind="note" @bind:event="oninput" autocomplete="off" />
                </div>
            </div>
        </div>

        <div class="wait">
            <div class="wait__control">
                <span class="label">Hold for</span>
                <input id="item-wait" type="number" min="@ItemService.MinWaitDays" max="@ItemService.MaxWaitDays"
                       @bind="waitDays" @bind:event="oninput" />
                <span class="label">days</span>
            </div>

            <p class="wait__date">
                @if (ReadyOn() is { } readyOn)
                {
                    @readyOn
                }
                else
                {
                    <span class="faint">Set a number of days</span>
                }
            </p>
        </div>

        @if (error is not null)
        {
            <p class="form-error" role="alert">@error</p>
        }

        @if (confirming)
        {
            <div class="add-panel__confirm">
                <p class="confirm-question">@($"Delete {Existing?.Title}?")</p>

                <div class="add-panel__actions">
                    <button type="button" @ref="confirmButton" @onclick="OnDelete">Delete</button>
                    <button type="button" class="quiet" @onclick="() => confirming = false">Cancel</button>
                </div>
            </div>
        }
        else
        {
            <div class="add-panel__actions">
                <button type="submit">@SubmitLabel</button>
                <button type="button" class="quiet" @onclick="OnCancel">Cancel</button>

                @if (OnDelete.HasDelegate)
                {
                    <button type="button" class="quiet delete" @onclick="Ask">Delete</button>
                }
            </div>
        }
    </form>
</div>

@code {
    [Parameter]
    public string Header { get; set; } = "Entered by hand";

    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public ScrapeOutcome? Outcome { get; set; }

    [Parameter]
    public string? InitialUrl { get; set; }

    /// <summary>
    /// A saved item to edit. When set, every field is seeded from it rather than from settings,
    /// and the wait control counts from the item's own <see cref="Item.SavedAt"/>.
    /// </summary>
    [Parameter]
    public Item? Existing { get; set; }

    [Parameter]
    public string SubmitLabel { get; set; } = "Start the hold";

    [Parameter]
    public EventCallback<ItemDraft> OnSubmit { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public EventCallback OnDelete { get; set; }

    private string? url;
    private string? note;
    private Category category = Category.Other;
    private int? waitDays;
    private string? error;
    private ElementReference firstInput;
    private ElementReference titleInput;

    private bool confirming;
    private bool pendingFocus;
    private ElementReference confirmButton;

    private bool priceIsEstimate;
    private bool estimateTouched;

    private string? Url
    {
        get => url;
        set
        {
            url = value;

            if (!estimateTouched)
            {
                priceIsEstimate = EstimatedPrice.LikelyEstimate(value);
            }
        }
    }

    private bool PriceIsEstimate
    {
        get => priceIsEstimate;
        set { priceIsEstimate = value; estimateTouched = true; }
    }

    private readonly HashSet<ProductField> touched = [];

    private string? title;
    private string? brand;
    private string? imageUrl;
    private decimal? price;
    private string? currency;

    private string? Title { get => title; set { title = value; touched.Add(ProductField.Title); } }
    private string? Brand { get => brand; set { brand = value; touched.Add(ProductField.Brand); } }
    private string? ImageUrl { get => imageUrl; set { imageUrl = value; touched.Add(ProductField.ImageUrl); } }
    private decimal? Price { get => price; set { price = value; touched.Add(ProductField.Price); } }
    private string? Currency { get => currency; set { currency = value; touched.Add(ProductField.Currency); } }

    protected override async Task OnInitializedAsync()
    {
        var settings = await SettingsService.GetAsync();

        waitDays = settings.DefaultWaitDays;
        currency = settings.PreferredCurrency;

        url = InitialUrl;

        if (Existing is { } item)
        {
            url = item.Url;
            title = item.Title;
            brand = item.Brand;
            imageUrl = item.ImageUrl;
            price = item.Price;
            currency = item.Currency;
            category = item.Category;
            waitDays = item.WaitDays;
            note = item.Note;
            priceIsEstimate = item.PriceIsEstimate;

            // The stored flag is a choice already made. Without this the Url setter re-runs
            // LikelyEstimate on the first keystroke and overwrites it.
            estimateTouched = true;

            return;
        }

        if (Outcome?.Info is { } info)
        {
            title = info.Title;
            brand = info.Brand;
            imageUrl = info.ImageUrl;
            price = info.Price;
            currency = info.Currency ?? settings.PreferredCurrency;
            url = info.Url;
        }

        priceIsEstimate = EstimatedPrice.LikelyEstimate(url);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Editing starts at the name; only the add flow wants the link field.
            await (Existing is null ? firstInput : titleInput).FocusAsync();
            return;
        }

        if (!pendingFocus)
        {
            return;
        }

        pendingFocus = false;
        await confirmButton.FocusAsync();
    }

    private void Ask()
    {
        confirming = true;
        pendingFocus = true;
    }

    private string? Faint(ProductField field) =>
        Outcome is not null && !touched.Contains(field) && Outcome.IsUnverified(field) ? "faint" : null;

    private string? PreviewSource()
    {
        var candidate = imageUrl?.Trim();

        return !string.IsNullOrEmpty(candidate)
            && Uri.TryCreate(candidate, UriKind.Absolute, out var uri)
            && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps)
                ? candidate
                : null;
    }

    private string? ReadyOn()
    {
        if (waitDays is not (>= ItemService.MinWaitDays and <= ItemService.MaxWaitDays))
        {
            return null;
        }

        var now = Time.GetUtcNow();

        // An edit counts from when the item was saved, not from today — otherwise the panel would
        // promise a date wrong by however many days it has already waited.
        var readyAt = (Existing?.SavedAt ?? now).AddDays(waitDays.Value);

        return $"{(readyAt <= now ? "Ready since" : "Ready on")} {readyAt.ToLocalTime():d MMM yyyy}";
    }

    private async Task Submit()
    {
        var draft = new ItemDraft(
            url,
            title ?? string.Empty,
            brand,
            imageUrl,
            price,
            currency ?? string.Empty,
            category,
            waitDays ?? 0,
            note,
            priceIsEstimate);

        error = ItemService.DescribeProblem(draft);

        if (error is not null)
        {
            return;
        }

        await OnSubmit.InvokeAsync(draft);
    }
}
