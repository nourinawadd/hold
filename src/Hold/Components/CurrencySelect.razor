<select id="@Id" class="@Class" value="@Value" @onchange="Changed">
    @if (AllowEmpty)
    {
        <option value="">--</option>
    }

    @foreach (var option in Currencies.Including(Value))
    {
        <option value="@option" selected="@(string.Equals(option, Value, StringComparison.OrdinalIgnoreCase))">@option</option>
    }
</select>

@code {
    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public string? Id { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public bool AllowEmpty { get; set; }

    private Task Changed(ChangeEventArgs args)
    {
        var chosen = args.Value as string;

        return ValueChanged.InvokeAsync(string.IsNullOrEmpty(chosen) ? null : chosen);
    }
}
