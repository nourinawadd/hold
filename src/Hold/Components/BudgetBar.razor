@if (Amount is { } budget && Currency is { } currency)
{
    <div class="budget @(Over ? "budget--over" : null)">
        <div class="budget__head">
            <span class="label">@(Over ? "Over budget" : "Budget")</span>
            <span class="budget__figures">@($"{(Estimated(currency) ? "≈ " : string.Empty)}{Spent(currency):N2} of {budget:N2} {currency}")</span>
        </div>

        <div class="budget__track">
            <div class="budget__fill" style="width: @Filled(budget, currency)%"></div>
        </div>

        @if (Estimates(currency) > 0)
        {
            <p class="budget__aside">@Guessed(currency)</p>
        }

        @if (Elsewhere(currency) is { Count: > 0 } others)
        {
            <p class="budget__aside">
                @($"Also holding {string.Join(" and ", others.Select(total => $"{total.Amount:N2} {total.Currency}"))}, not counted against this budget.")
            </p>
        }
    </div>
}

@code {
    [Parameter]
    public decimal? Amount { get; set; }

    [Parameter]
    public string? Currency { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<CurrencyTotal> Totals { get; set; } = [];

    private bool Over => Amount is { } budget && Currency is { } currency && Spent(currency) > budget;

    private decimal Spent(string currency) =>
        Totals.Where(total => total.Currency.Equals(currency, StringComparison.OrdinalIgnoreCase))
            .Sum(total => total.Amount);

    private int Estimates(string currency) =>
        Totals.Where(total => total.Currency.Equals(currency, StringComparison.OrdinalIgnoreCase))
            .Sum(total => total.EstimateCount);

    private bool Estimated(string currency) => Estimates(currency) > 0;

    private string Guessed(string currency) =>
        Estimates(currency) == 1
            ? "Includes one estimated price."
            : $"Includes {Estimates(currency)} estimated prices.";

    private IReadOnlyList<CurrencyTotal> Elsewhere(string currency) =>
        Totals.Where(total => !total.Currency.Equals(currency, StringComparison.OrdinalIgnoreCase))
            .ToList();

    private int Filled(decimal budget, string currency) =>
        budget <= 0 ? 100 : (int)Math.Clamp(Spent(currency) / budget * 100m, 0m, 100m);
}
