@inherits LayoutComponentBase

<header class="topbar">
    <a class="wordmark" href="">Hold</a>

    <AuthorizeView>
        <Authorized>
            <nav class="topnav">
                <NavLink class="topnav__link" href="lists" Match="NavLinkMatch.All">Lists</NavLink>
                <NavLink class="topnav__link" href="items">All items</NavLink>
                <NavLink class="topnav__link" href="settings">Settings</NavLink>
            </nav>

            <div class="account">
                <a class="account__who" href="you">
                    <span class="account__full">@Who(context)</span>
                    <span class="account__short">@FirstName(context)</span>
                </a>

                <form class="account__out" method="post" action="/account/logout">
                    <AntiforgeryToken />
                    <button type="submit" class="quiet">Sign out</button>
                </form>
            </div>
        </Authorized>
    </AuthorizeView>
</header>

<main class="content">

    <ErrorBoundary @ref="boundary">
        <ChildContent>
            @Body
        </ChildContent>

        <ErrorContent>
            <div class="broke">
                <h1>That did not load</h1>

                <p class="broke__line">
                    Something on this page failed. Nothing you saved has been lost.
                </p>

                <button type="button" @onclick="Recover">Try again</button>
            </div>
        </ErrorContent>
    </ErrorBoundary>
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private ErrorBoundary? boundary;

    private static string Who(AuthenticationState state)
    {
        var name = state.User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
            ?? state.User.Identity?.Name;

        if (!string.IsNullOrWhiteSpace(name))
        {
            return name.Trim();
        }

        var email = state.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;

        return string.IsNullOrWhiteSpace(email) ? "Signed in" : StatsService.LocalPart(email);
    }

    private static string FirstName(AuthenticationState state) =>
        Who(state).Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "You";

    private void Recover() => boundary?.Recover();

    protected override void OnParametersSet() => boundary?.Recover();
}
