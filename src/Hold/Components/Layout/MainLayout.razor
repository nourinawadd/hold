@inherits LayoutComponentBase

<header class="topbar">
    <a class="wordmark" href="">Hold</a>

    @* Navigation and the account block are both hidden when signed out, so the sign-in page
       and a shared link show the wordmark alone rather than links that lead to a redirect. *@
    <AuthorizeView>
        <Authorized>
            <nav class="topnav">
                <NavLink class="topnav__link" href="lists" Match="NavLinkMatch.All">Lists</NavLink>
                <NavLink class="topnav__link" href="items">All items</NavLink>
                <NavLink class="topnav__link" href="settings">Settings</NavLink>
            </nav>

            <div class="account">
                <span class="account__who">@Who(context)</span>

                @* A form post, not a button with an @onclick. Clearing the cookie means
                   writing a response header, which an interactive circuit cannot do. *@
                <form class="account__out" method="post" action="/account/logout">
                    <AntiforgeryToken />
                    <button type="submit" class="quiet">Sign out</button>
                </form>
            </div>
        </Authorized>
    </AuthorizeView>
</header>

<main class="content">
    @* Catches a component that threw, so one broken card cannot blank the whole page. The
       #blazor-error-ui bar in app.css handles the different failure of a dropped circuit.

       No red: a fault is not permission to buy something. *@
    <ErrorBoundary @ref="boundary">
        <ChildContent>
            @Body
        </ChildContent>

        <ErrorContent>
            <div class="broke">
                <h1>That did not load</h1>

                <p class="broke__line">
                    Something on this page failed. Nothing you saved has been lost.
                </p>

                <button type="button" @onclick="Recover">Try again</button>
            </div>
        </ErrorContent>
    </ErrorBoundary>
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private ErrorBoundary? boundary;

    // Email rather than display name: with open signup two people can share a first name,
    // and the address is the thing that says which account you are actually in.
    private static string Who(AuthenticationState state) =>
        state.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
        ?? state.User.Identity?.Name
        ?? "Signed in";

    // Without this the boundary stays latched and the message never goes away, even after
    // navigating somewhere that works.
    private void Recover() => boundary?.Recover();

    protected override void OnParametersSet() => boundary?.Recover();
}
