@page "/lists/{Id:int}"
@inject ListService ListService
@inject ItemService ItemService
@inject TimeProvider Time

<PageTitle>@(detail?.Name ?? "List") — Hold</PageTitle>

@if (!loaded)
{
    <p class="meta">Loading</p>
}
else if (detail is null)
{
    @* Deleted, or a bad link. A plain sentence — no red, no error styling. *@
    <a class="back" href="/lists">← Lists</a>

    <div class="page-head">
        <h1>Not here</h1>
    </div>

    <p class="missing">That list has been deleted, or the link is wrong.</p>
}
else
{
    <a class="back" href="/lists">← Lists</a>

    <div class="page-head">
        <h1>@detail.Name</h1>

        <div class="page-head__right">
            <span class="meta">@Count()</span>
            <span class="meta">@Totals()</span>

            @if (Budget() is { } budget)
            {
                <span class="meta">@budget</span>
            }
        </div>
    </div>

    @if (detail.Description is not null)
    {
        <p class="description">@detail.Description</p>
    }

    @* The paste field is always here, and on an empty list it *is* the empty state —
       focused and waiting, with no separate call to action. Keyed so a completed add
       hands back a fresh panel in its paste state. *@
    <AddItem @key="addKey" OnSubmit="Add" />

    @if (items.Count == 0)
    {
        <div class="ghosts">
            @for (var slot = 0; slot < 4; slot++)
            {
                <div class="ghost"></div>
            }
        </div>
    }
    else
    {
        @* Filtering the grid, so it sits with the grid rather than above the paste field. *@
        <CategoryStrip Selected="category" Available="present" SelectedChanged="c => category = c" />
        <ItemSearch Value="@search" ValueChanged="s => search = s" />
    }

    @if (items.Count > 0 && Shown.Count == 0)
    {
        <p class="nothing">@Nothing()</p>
    }
    else if (items.Count > 0)
    {
        // Read once per render so every card agrees on which items are ready.
        var now = Time.GetUtcNow();

        <div class="item-grid">
            @foreach (var item in Waiting)
            {
                <ItemCard @key="item.Id" Item="item" Now="now" OnStatusChange="ChangeStatus" />
            }
        </div>

        @if (Closed.Any())
        {
            @* A structural rule, because what you have decided about is a different zone
               from what you are still waiting on. *@
            <div class="closed-rule">
                <span class="label">Decided</span>
            </div>

            <div class="item-grid">
                @foreach (var item in Closed)
                {
                    <ItemCard @key="item.Id" Item="item" Now="now" OnStatusChange="ChangeStatus" />
                }
            </div>
        }
    }

    <ListShare ListId="Id" />

    @* Pinned at the foot of the content. Counts only its own currency; the totals it cannot
       count are named beneath it. *@
    <BudgetBar Amount="detail.BudgetAmount" Currency="@detail.BudgetCurrency" Totals="detail.Totals" />
}

@code {
    [Parameter]
    public int Id { get; set; }

    // Qualified: this page compiles to a class also called ListDetail, which would
    // otherwise shadow the record the service returns.
    private Hold.Services.ListDetail? detail;

    private IReadOnlyList<Item> items = [];
    private bool loaded;
    private int addKey;

    private Category? category;
    private string? search;

    /// <summary>
    /// The filter runs over what is already loaded — no round trip to narrow a list that is
    /// in hand. Reuses ItemService.Matches so this page and /items agree on what a match is.
    /// </summary>
    private IReadOnlyList<Item> Shown => items
        .Where(item => (category is null || item.Category == category)
            && ItemService.Matches(item, search))
        .ToList();

    /// <summary>Computed from every item, not the filtered set, so choosing a category does
    /// not make the other options disappear.</summary>
    private IReadOnlySet<Category> present => items.Select(item => item.Category).ToHashSet();

    // ItemService.Sort already puts waiting first, ready ahead of the rest, then oldest
    // first within each group — so filtering here preserves that order.
    private IEnumerable<Item> Waiting => Shown.Where(item => item.Status == ItemStatus.Waiting);

    private IEnumerable<Item> Closed => Shown.Where(item => item.Status != ItemStatus.Waiting);

    // Names what was looked for rather than announcing a failure.
    private string Nothing() => (category, string.IsNullOrWhiteSpace(search)) switch
    {
        (not null, false) => $"Nothing in {category} matches “{search!.Trim()}”.",
        (not null, true) => $"Nothing in this list is filed under {category}.",
        (null, false) => $"Nothing in this list matches “{search!.Trim()}”.",
        _ => "Nothing here.",
    };

    // OnParametersSetAsync, not OnInitializedAsync: navigating between two list ids reuses
    // this component instance, and OnInitialized would not run again.
    protected override async Task OnParametersSetAsync()
    {
        loaded = false;
        await Load();
        loaded = true;
    }

    private async Task Load()
    {
        detail = await ListService.GetDetailAsync(Id);
        items = detail is null ? [] : await ItemService.GetForListAsync(Id);
    }

    private async Task Add(ItemDraft draft)
    {
        await ItemService.AddAsync(Id, draft);

        // A new key resets the add flow to its paste state, ready for the next link.
        addKey++;

        // Re-read the list too: the count and the totals both moved.
        await Load();
    }

    private async Task ChangeStatus((int Id, ItemStatus Status) change)
    {
        await ItemService.SetStatusAsync(change.Id, change.Status);
        await Load();
    }

    private string Count() => detail!.ItemCount == 1 ? "1 item" : $"{detail.ItemCount} items";

    // One figure per currency; amounts are never combined across currencies.
    private string Totals() =>
        detail!.Totals.Count == 0
            ? "—"
            : string.Join(" · ", detail.Totals.Select(total => $"{total.Amount:N2} {total.Currency}"));

    // One line of text. The budget bar itself is phase 7.
    private string? Budget() =>
        detail!.BudgetAmount is { } amount && detail.BudgetCurrency is { } currency
            ? $"Budget {amount:N2} {currency}"
            : null;
}
