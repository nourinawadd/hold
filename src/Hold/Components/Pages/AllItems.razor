@page "/items"
@inject ItemService ItemService
@inject ListService ListService
@inject TimeProvider Time

<PageTitle>All items — Hold</PageTitle>

<div class="page-head">
    <h1>All items</h1>

    <div class="page-head__right">
        <span class="meta">@Count()</span>
    </div>
</div>

<CategoryStrip Selected="category" Available="present" SelectedChanged="ChooseCategory" />
<ItemSearch Value="@search" ValueChanged="Typed" />

@if (!loaded)
{
    <p class="meta">Loading</p>
}
else
{
    @if (Searching && matchingLists.Count > 0)
    {
        var now = Time.GetUtcNow();

        <div class="section">
            <span class="label">Lists</span>
        </div>

        <div class="list-grid">
            @foreach (var list in matchingLists)
            {
                <ListCard @key="list.Id" List="list" Now="now" />
            }
        </div>

        <div class="section">
            <span class="label">Items</span>
        </div>
    }

    @if (items.Count == 0)
    {
        <p class="nothing">@Nothing()</p>
    }
    else
    {
        var now = Time.GetUtcNow();

        <div class="item-grid">
            @foreach (var item in items)
            {
                <ItemCard @key="item.Id" Item="item" Now="now" ShowList
                          OnStatusChange="ChangeStatus" OnRecheck="Recheck" />
            }
        </div>
    }
}

@code {
    private IReadOnlyList<Item> items = [];
    private IReadOnlyList<ListSummary> matchingLists = [];
    private IReadOnlySet<Category> present = new HashSet<Category>();
    private Category? category;
    private string? search;
    private bool loaded;

    private bool Searching => !string.IsNullOrWhiteSpace(search);

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        items = await ItemService.GetAllAsync(new ItemFilter(category, search));

        var all = await ItemService.GetAllAsync(new ItemFilter(null, search));
        present = all.Select(item => item.Category).ToHashSet();

        matchingLists = Searching
            ? (await ListService.GetSummariesAsync())
                .Where(list => Contains(list.Name, search!))
                .ToList()
            : [];

        loaded = true;
    }

    private static bool Contains(string haystack, string needle) =>
        System.Globalization.CultureInfo.InvariantCulture.CompareInfo.IndexOf(
            haystack,
            needle.Trim(),
            System.Globalization.CompareOptions.IgnoreCase
                | System.Globalization.CompareOptions.IgnoreNonSpace) >= 0;

    private async Task ChooseCategory(Category? chosen)
    {
        category = chosen;
        await Load();
    }

    private async Task Typed(string? value)
    {
        search = value;
        await Load();
    }

    private async Task ChangeStatus((int Id, ItemStatus Status) change)
    {
        await ItemService.SetStatusAsync(change.Id, change.Status);
        await Load();
    }

    private async Task<PriceCheckResult> Recheck(int itemId)
    {
        var result = await ItemService.RecheckPriceAsync(itemId);

        await Load();

        return result;
    }

    private string Count() => items.Count == 1 ? "1 item" : $"{items.Count} items";

    private string Nothing() => (category, Searching) switch
    {
        (not null, true) => $"Nothing in {category} matches “{search!.Trim()}”.",
        (not null, false) => $"Nothing saved under {category} yet.",
        (null, true) => $"Nothing matches “{search!.Trim()}”.",
        _ => "Save something and it will show up here.",
    };
}
