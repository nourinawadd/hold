@page "/"
@page "/lists"
@inject ListService ListService
@inject TimeProvider Time

<PageTitle>Lists — Hold</PageTitle>

<div class="page-head">
    <h1>Lists</h1>
    <span class="meta">@summaries.Count lists · @summaries.Sum(l => l.ItemCount) items</span>
</div>

<div class="list-grid">
    @foreach (var list in summaries)
    {
        <article class="list-card">
            <div class="thumbs">
                @for (var slot = 0; slot < 5; slot++)
                {
                    <div class="thumb @(slot < list.ItemCount ? "thumb--filled" : null)"></div>
                }
            </div>

            <div class="list-card__foot">
                <div>
                    <h2>@list.Name</h2>
                    <p class="meta">@list.ItemCount products · @Ago(list.UpdatedAt)</p>
                </div>
                <span class="meta">@Total(list)</span>
            </div>
        </article>
    }
</div>

@code {
    private IReadOnlyList<ListSummary> summaries = [];

    protected override async Task OnInitializedAsync()
    {
        summaries = await ListService.GetSummariesAsync();
    }

    private string Ago(DateTimeOffset when)
    {
        var elapsed = Time.GetUtcNow() - when;

        return elapsed switch
        {
            { TotalMinutes: < 2 } => "just now",
            { TotalHours: < 1 } => $"{(int)elapsed.TotalMinutes} minutes ago",
            { TotalHours: < 24 } => $"{(int)elapsed.TotalHours} hours ago",
            { TotalDays: < 30 } => $"{(int)elapsed.TotalDays} days ago",
            // Stored as UTC, so format in local time or the date slips near midnight.
            _ => when.ToLocalTime().ToString("d MMM yyyy"),
        };
    }

    // One line per currency; amounts are never combined across currencies.
    private static string Total(ListSummary list) =>
        list.Totals.Count == 0
            ? "—"
            : string.Join(" · ", list.Totals.Select(total => $"{total.Amount:N2} {total.Currency}"));
}
