@page "/"
@page "/lists"
@inject ListService ListService
@inject SettingsService SettingsService
@inject TimeProvider Time

<PageTitle>Lists — Hold</PageTitle>

@if (summaries.Count == 0 && mode is Mode.None)
{
    <div class="empty">
        <h1>Start a list</h1>

        <p class="empty__line">
            Save something you want, choose how long to wait, and Hold counts the days.
        </p>

        <button type="button" @onclick="() => StartCreate()">New list</button>

        <div class="empty__suggestions">
            <span class="label">Or start with</span>

            @foreach (var suggestion in ListForm.Suggestions)
            {
                <button type="button" class="chip" @onclick="() => StartCreate(suggestion)">@suggestion</button>
            }
        </div>
    </div>
}
else
{
    <div class="page-head">
        <h1>Lists</h1>

        <div class="page-head__right">
            <span class="meta">@summaries.Count lists · @summaries.Sum(list => list.ItemCount) items</span>
            <button type="button" @onclick="() => StartCreate()">New list</button>
        </div>
    </div>

    @if (mode is not Mode.None)
    {
        <ListForm @key="(mode, editId, prefillName)"
                  SubmitLabel="@(mode is Mode.Create ? "Create" : "Save")"
                  InitialName="@prefillName"
                  InitialDescription="@prefillDescription"
                  InitialBudgetAmount="prefillBudgetAmount"
                  InitialBudgetCurrency="@prefillBudgetCurrency"
                  ShowSuggestions="showSuggestions"
                  OnSubmit="Save"
                  OnCancel="Close" />
    }

    var now = Time.GetUtcNow();

    <div class="list-grid">
        @foreach (var list in summaries)
        {
            <ListCard @key="list.Id"
                      List="list"
                      Now="now"
                      ImageWidth="ProductImage.StripWidth"
                      OnRename="StartRename"
                      OnDelete="Delete" />
        }
    </div>
}

@code {
    private enum Mode { None, Create, Rename }

    private IReadOnlyList<ListSummary> summaries = [];

    private Mode mode = Mode.None;
    private int editId;
    private string? prefillName;
    private string? prefillDescription;
    private decimal? prefillBudgetAmount;
    private string? prefillBudgetCurrency;
    private bool showSuggestions;
    private string preferredCurrency = "USD";

    protected override async Task OnInitializedAsync()
    {
        preferredCurrency = (await SettingsService.GetAsync()).PreferredCurrency;

        await Reload();
    }

    private void StartCreate(string? withName = null)
    {
        mode = Mode.Create;
        editId = 0;
        prefillName = withName;
        prefillDescription = null;
        prefillBudgetAmount = null;
        prefillBudgetCurrency = preferredCurrency;

        showSuggestions = withName is null;
    }

    private async Task StartRename(int id)
    {
        var detail = await ListService.GetDetailAsync(id);

        if (detail is null)
        {
            await Reload();
            return;
        }

        mode = Mode.Rename;
        editId = id;
        prefillName = detail.Name;
        prefillDescription = detail.Description;
        prefillBudgetAmount = detail.BudgetAmount;
        prefillBudgetCurrency = detail.BudgetCurrency ?? preferredCurrency;
        showSuggestions = false;
    }

    private void Close() => mode = Mode.None;

    private async Task Save(ListService.ListDraft draft)
    {
        if (mode is Mode.Create)
        {
            await ListService.CreateAsync(draft, preferredCurrency);
        }
        else
        {
            await ListService.RenameAsync(editId, draft, preferredCurrency);
        }

        Close();
        await Reload();
    }

    private async Task Delete(int id)
    {
        await ListService.DeleteAsync(id);

        if (mode is Mode.Rename && editId == id)
        {
            Close();
        }

        await Reload();
    }

    private async Task Reload() => summaries = await ListService.GetSummariesAsync();
}
