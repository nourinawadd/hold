@page "/sign-in"
@attribute [AllowAnonymous]
@layout Layout.MainLayout
@inject SignInAvailability Availability

<PageTitle>Sign in — Hold</PageTitle>

<div class="signin">
    <h1>Hold</h1>

    <p class="signin__line">
        A wishlist that tracks how long you've wanted something.
    </p>

    @if (Availability.GoogleConfigured)
    {
        <a class="signin__go" href="@LoginHref()">Continue with Google</a>

        <a class="signin__demo" href="/s/@WishList.DemoShareToken">or see an example list</a>

        <p class="signin__foot">
            Signing in creates an account the first time. Your lists are private to it.
        </p>
    }
    else
    {
        <p class="signin__foot">
            Sign-in is not configured on this deployment.
            Set <code>Authentication:Google:ClientId</code> and <code>ClientSecret</code>.
        </p>
    }
</div>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private string LoginHref() =>
        string.IsNullOrWhiteSpace(ReturnUrl)
            ? "/account/login"
            : $"/account/login?returnUrl={Uri.EscapeDataString(ReturnUrl)}";
}
