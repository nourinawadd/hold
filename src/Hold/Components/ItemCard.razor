<article class="item-card @(IsClosed ? "item-card--closed" : null)">
    @if (Item.Url is { } link)
    {
        <a class="item-card__image" href="@link" target="_blank" rel="noopener noreferrer">
            @Thumbnail
        </a>
    }
    else
    {
        <div class="item-card__image">
            @Thumbnail
        </div>
    }

    <div class="item-card__body">
        <h3>@Item.Title</h3>

        <p class="meta">@Facets()</p>

        @if (ShowList && Item.WishList is { } list)
        {
            <a class="item-card__list" href="/lists/@list.Id">@list.Name</a>
        }

        @if (Item.Price is { } amount)
        {
            <p class="price @(Item.PriceIsEstimate ? "faint" : null)">
                @(Item.PriceIsEstimate ? $"≈ {amount:N2} {Item.Currency}" : $"{amount:N2} {Item.Currency}")
            </p>

            @if (Item.PriceIsEstimate)
            {
                <p class="label price__kind">Estimated price</p>
            }
            else if (Item.LatestPrice is { } latest && latest != amount)
            {
                <p class="price__now">@($"Now {latest:N2} {Item.Currency}")</p>
            }
        }
        else
        {
            <p class="price faint">—</p>
        }

        @if (checkMessage is { } said)
        {
            <p class="price__said">@said</p>
        }

        @if (Item.Note is { } note)
        {
            <p class="item-card__note">@note</p>
        }

        <div class="tally @TallyModifier()">
            <span class="tally__count">@Days</span>

            @if (IsClosed)
            {
                <span class="tally__label">@($"days · {(Item.Status == ItemStatus.Bought ? "bought" : "let go")}")</span>
            }
            else
            {
                <span class="tally__label">@(Ready ? "Ready" : "days waited")</span>

                <div class="wait-rule">
                    <div class="wait-rule__fill" style="width: @Elapsed()%"></div>
                </div>

                @if (!Ready)
                {
                    <p class="tally__date">Ready @ReadyOn()</p>
                }
            }
        </div>
    </div>

    @if (HasActions)
    {
        <div class="item-card__actions">
            @if (CanDecide)
            {
                @if (IsClosed)
                {
                    <button type="button" class="quiet" @onclick="() => Set(ItemStatus.Waiting)">Reopen</button>
                }
                else
                {
                    <button type="button" class="quiet" @onclick="() => Set(ItemStatus.Bought)">Bought</button>
                    <button type="button" class="quiet" @onclick="() => Set(ItemStatus.LetGo)">Let go</button>
                }
            }

            @if (CanRecheck)
            {
                <button type="button" class="quiet" disabled="@checking" @onclick="Recheck">
                    @(checking ? "Reading" : "Re-check price")
                </button>
            }

            @if (OnEdit.HasDelegate)
            {
                <button type="button" class="quiet" @onclick="() => OnEdit.InvokeAsync(Item.Id)">Edit</button>
            }
        </div>
    }
</article>

@code {
    private RenderFragment Thumbnail => @<text>
        @if (Item.ImageUrl is { } source)
        {
            <img src="@ProductImage.AtWidth(source, ProductImage.CardWidth)" alt="" loading="lazy" />
        }
        else
        {
            <div class="item-card__noimage"></div>
        }
    </text>;

    [Parameter, EditorRequired]
    public Item Item { get; set; } = null!;

    [Parameter, EditorRequired]
    public DateTimeOffset Now { get; set; }

    [Parameter]
    public bool ShowList { get; set; }

    [Parameter]
    public EventCallback<(int Id, ItemStatus Status)> OnStatusChange { get; set; }

    [Parameter]
    public Func<int, Task<PriceCheckResult>>? OnRecheck { get; set; }

    /// <summary>
    /// Left unset on read-only surfaces, which is what keeps the button off the shared list.
    /// </summary>
    [Parameter]
    public EventCallback<int> OnEdit { get; set; }

    private bool checking;
    private string? checkMessage;

    // Every action is derived from whether a handler was supplied, never from a flag the caller has to
    // remember to set. A read-only surface simply passes no callbacks and the row disappears.
    private bool CanDecide => OnStatusChange.HasDelegate;

    private bool CanRecheck =>
        OnRecheck is not null
        && Item.Url is not null
        && Item.Price is not null
        && !Item.PriceIsEstimate;

    private bool HasActions => CanDecide || CanRecheck || OnEdit.HasDelegate;

    private async Task Recheck()
    {
        checking = true;
        checkMessage = null;

        try
        {
            checkMessage = (await OnRecheck!(Item.Id)).Message;
        }
        finally
        {
            checking = false;
        }
    }

    private bool IsClosed => Item.Status != ItemStatus.Waiting;

    private bool Ready => Item.IsReady(Now);

    private int Days => Item.DaysWaited(Item.ClosedAt ?? Now);

    private string? TallyModifier() => IsClosed ? "tally--closed" : Ready ? "tally--ready" : null;

    private int Elapsed() =>
        Item.WaitDays <= 0 ? 100 : Math.Clamp(Days * 100 / Item.WaitDays, 0, 100);

    private Task Set(ItemStatus status) => OnStatusChange.InvokeAsync((Item.Id, status));

    private string Facets() =>
        Item.Brand is { } brand ? $"{brand} · {Item.Category}" : Item.Category.ToString();

    private string ReadyOn() => Item.ReadyAt.ToLocalTime().ToString("d MMM yyyy");
}
