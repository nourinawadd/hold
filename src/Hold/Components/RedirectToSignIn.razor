@attribute [AllowAnonymous]
@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        var target = Navigation.ToBaseRelativePath(Navigation.Uri);

        var query = string.IsNullOrEmpty(target) || target.StartsWith("sign-in", StringComparison.OrdinalIgnoreCase)
            ? string.Empty
            : $"?returnUrl={Uri.EscapeDataString("/" + target)}";

        Navigation.NavigateTo($"/sign-in{query}", forceLoad: false, replace: true);
    }
}
