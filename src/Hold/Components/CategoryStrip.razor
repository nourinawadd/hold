<div class="strip" role="group" aria-label="Filter by category">
    <button type="button"
            class="strip__option @(Selected is null ? "strip__option--on" : null)"
            @onclick="() => Choose(null)">
        All
    </button>

    @foreach (var category in Enum.GetValues<Category>())
    {
        if (Available.Count == 0 || Available.Contains(category))
        {
            <button type="button"
                    class="strip__option @(Selected == category ? "strip__option--on" : null)"
                    @onclick="() => Choose(category)">
                @category
            </button>
        }
    }
</div>

@code {
    [Parameter]
    public Category? Selected { get; set; }

    [Parameter]
    public IReadOnlySet<Category> Available { get; set; } = new HashSet<Category>();

    [Parameter]
    public EventCallback<Category?> SelectedChanged { get; set; }

    private Task Choose(Category? category) =>
        SelectedChanged.InvokeAsync(Selected == category ? null : category);
}
